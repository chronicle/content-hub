set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
else
  echo "[pre-commit] ERROR: python3 is required to run the secret scanner." >&2
  exit 1
fi

"$PYTHON_BIN" "$REPO_ROOT/tools/security/scan_secrets.py" \
  --mode staged \
  --repo-root "$REPO_ROOT"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git \
    --pre-commit \
    --staged \
    --redact \
    --no-banner \
    --config "$REPO_ROOT/.gitleaks.toml" \
    "$REPO_ROOT"
fi
