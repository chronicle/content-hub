{
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "body": [
        {
            "type": "TextBlock",
            "text": "New alert in Google SecOps",
            "weight": "Bolder",
            "size": "Medium",
            "wrap": true
        },
        {
            "type": "FactSet",
            "facts": [
                {"title": "Severity", "value": "High"},
                {"title": "Status", "value": "Open"}
            ]
        }
    ],
    "actions": [
        {
            "type": "Action.OpenUrl",
            "title": "Open case",
            "url": "https://example.com/case/1"
        }
    ]
}
