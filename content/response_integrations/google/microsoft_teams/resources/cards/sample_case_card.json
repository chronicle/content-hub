{
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "msteams": {
        "width": "Full"
    },
    "body": [
        {
            "type": "Container",
            "style": "accent",
            "bleed": true,
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "GOOGLE SECOPS  |  CASE #1234",
                                    "size": "Small",
                                    "weight": "Bolder",
                                    "isSubtle": true
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "auto",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "INFORMATIONAL",
                                    "size": "Small",
                                    "weight": "Bolder",
                                    "color": "Accent"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "TextBlock",
                    "text": "Example case title",
                    "size": "Large",
                    "weight": "Bolder",
                    "wrap": true,
                    "spacing": "Small"
                },
                {
                    "type": "TextBlock",
                    "text": "Created {{DATE(2023-11-14T22:13:20Z,LONG)}} {{TIME(2023-11-14T22:13:20Z)}}",
                    "size": "Small",
                    "isSubtle": true,
                    "spacing": "None"
                }
            ]
        },
        {
            "type": "FactSet",
            "spacing": "Medium",
            "facts": [
                {
                    "title": "Stage",
                    "value": "Example stage"
                },
                {
                    "title": "Status",
                    "value": "Open"
                },
                {
                    "title": "Priority",
                    "value": "Informational"
                },
                {
                    "title": "Environment",
                    "value": "Example environment"
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "Alert",
            "weight": "Bolder",
            "size": "Medium",
            "separator": true,
            "spacing": "Medium"
        },
        {
            "type": "Container",
            "style": "emphasis",
            "spacing": "Small",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "Example alert",
                    "weight": "Bolder",
                    "wrap": true
                },
                {
                    "type": "FactSet",
                    "facts": [
                        {
                            "title": "Product",
                            "value": "Acme Sensor"
                        },
                        {
                            "title": "Rule generator",
                            "value": "Example rule"
                        },
                        {
                            "title": "Events",
                            "value": "1"
                        }
                    ]
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "Tags",
            "weight": "Bolder",
            "size": "Medium",
            "separator": true,
            "spacing": "Medium"
        },
        {
            "type": "TextBlock",
            "text": "tag-one  |  tag-two  |  tag-three",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "Recent activity",
            "weight": "Bolder",
            "size": "Medium",
            "separator": true,
            "spacing": "Medium"
        },
        {
            "type": "TextBlock",
            "text": "- Tag 'tag-one' added\n- Example playbook attached after case assignee change",
            "wrap": true,
            "isSubtle": true
        }
    ]
}
